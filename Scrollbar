from tkinter import *

root = Tk()

frame = Frame(root)
frame.pack()

scroll = Scrollbar(frame)

listbox = Listbox(frame,
                  yscrollcommand=scroll.set)

for i in range(200):
    listbox.insert(END, f"Student {i}")

scroll.pack(side=RIGHT,
            fill=Y)

listbox.pack(side=LEFT)

scroll.config(command=listbox.yview)

root.mainloop()

